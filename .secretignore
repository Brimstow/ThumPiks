# .secretignore - Files excluded from secret scanning
# Syntax matches .gitignore (glob patterns, one per line)
# Used by secretlint, security-scan.js, and CI secret detection

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Test coverage
coverage/
**/coverage/

# Test files (contain mock credentials, fake tokens, test passwords)
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js

# E2E test files (use test credentials intentionally)
tests/e2e/
**/tests/e2e/

# Seed files (contain test user accounts with known credentials)
prisma/seed.ts
**/prisma/seed.ts

# Test helper scripts (contain test credentials for verification)
verify-test-users.ts
**/verify-test-users.ts
test-*.mjs
test-*.ts
test-*.js

# Security test/report files (contain scanned results, may have redacted secrets)
security-test-results.json
git-security-report.json
**/security-test-results.json
**/git-security-report.json

# Documentation (may contain example/redacted secrets in guides)
*.md
**/*.md
docs/
**/docs/

# Example/env template files (not real secrets)
.env.example
.env.template
**/.env.example
**/.env.template

# Lock files (may contain hashed URLs/tokens in registry paths)
package-lock.json
yarn.lock
pnpm-lock.yaml
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Generated/config artifacts
.netlify/
**/.netlify/
.agentsmesh/
**/.agentsmesh/
