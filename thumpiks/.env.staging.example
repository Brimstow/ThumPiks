# =============================================================================
# STAGING ENVIRONMENT OVERRIDES
# =============================================================================
# This file documents the variables that DIFFER from production.
# All other variables should match production (copy from Railway production env).
#
# Setup: In Railway, duplicate the production environment, then override
# ONLY the variables listed below in the staging environment settings.
# =============================================================================

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV="staging"

# ─── Database (Railway auto-provisions a separate PostgreSQL) ────────────────
# Railway sets DATABASE_URL automatically when you add a PostgreSQL plugin.
# Verify it points to the STAGING database, NOT production.
# DATABASE_URL="postgresql://...staging-db..."

# ─── Redis (Railway auto-provisions a separate Redis) ────────────────────────
# Railway sets REDIS_URL automatically when you add a Redis plugin.
# REDIS_URL="redis://...staging-redis..."

# ─── CORS (must include staging frontend URL) ───────────────────────────────
# Replace with your actual staging frontend domain
CORS_ORIGIN="https://staging--thumbnail-maker-studio.netlify.app"

# ─── Client URL (staging frontend) ──────────────────────────────────────────
CLIENT_URL="https://staging--thumbnail-maker-studio.netlify.app"

# ─── Stripe (USE TEST MODE KEYS) ────────────────────────────────────────────
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# If you don't have test keys yet, leave empty — Stripe features will be
# non-functional but the rest of the app will work fine.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Seed Data ───────────────────────────────────────────────────────────────
# The seed script auto-detects NODE_ENV=staging and seeds test users.
# Run after first deploy: railway run npx prisma db seed
# Or set this to force seeding even in production-like envs:
# SEED_TEST_USERS="true"

# =============================================================================
# VARIABLES THAT STAY THE SAME AS PRODUCTION
# =============================================================================
# These are typically copied automatically when you duplicate the environment.
# Verify they are present but do NOT change them:
#
# JWT_SECRET, REFRESH_TOKEN_SECRET, ENCRYPTION_KEY
#   → Use the same strong secrets (or generate new ones for isolation)
#
# CLOUDINARY_URL
#   → Same Cloudinary account is fine (images are namespaced by user)
#
# OPENROUTER_API_KEY, REPLICATE_API_KEY, COMET_API_KEY, ZENMUX_API_KEY
#   → Same AI keys for both environments (usage is low in staging)
#
# AXIOM_TOKEN, AXIOM_DATASET
#   → Consider using a separate dataset like "thumbnail-maker-staging"
#     to keep staging logs separate from production
#
# All ENABLE_* feature flags
#   → Should match production to ensure feature parity
# =============================================================================
