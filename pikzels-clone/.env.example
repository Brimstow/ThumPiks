# =============================================================================
# SECURITY CONFIGURATION - CRITICAL FOR PRODUCTION
# =============================================================================

# Database Configuration
# Connection pool parameters (appended to URL as query params):
#   connection_limit=10  Max pool connections (Railway shared PG supports ~97 total across all clients)
#   pool_timeout=10      Seconds to wait for an available connection before timing out
#   connect_timeout=10   Seconds to wait when establishing a new connection (10s for Railway network latency)
DATABASE_URL="postgresql://username:password@localhost:5432/thumbnail_maker?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=10"
# For development: "file:./dev.db"

# JWT Security (CRITICAL - MUST BE CHANGED IN PRODUCTION)
JWT_SECRET="CHANGE_ME_TO_SECURE_32_CHAR_SECRET"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
JWT_RESET_EXPIRY="1h"

# Encryption Keys
ENCRYPTION_KEY="CHANGE_ME_TO_SECURE_32_CHAR_KEY__"
REFRESH_TOKEN_SECRET="CHANGE_ME_TO_SECURE_32_CHAR_REFR"

# =============================================================================
# STRIPE CONFIGURATION (SUBSCRIPTION & PAYMENTS)
# =============================================================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs for each plan (create these in Stripe Dashboard)
STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly_id"
STRIPE_PRICE_STARTER_ANNUAL="price_starter_annual_id"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly_id"
STRIPE_PRICE_PRO_ANNUAL="price_pro_annual_id"
STRIPE_PRICE_BUSINESS_MONTHLY="price_business_monthly_id"
STRIPE_PRICE_BUSINESS_ANNUAL="price_business_annual_id"

# =============================================================================
# POLAR CONFIGURATION (Merchant of Record - Alternative to Stripe)
# Polar handles international tax compliance (VAT, GST, US Sales Tax)
# Get credentials from: https://polar.sh/dashboard → Settings → Developers
# =============================================================================
# Set BILLING_PROVIDER to choose which provider handles NEW checkouts
# Existing subscriptions continue to be managed by their original provider
BILLING_PROVIDER="stripe"  # "stripe" | "polar"

POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""
POLAR_SANDBOX="true"  # Set to "false" for production

# Polar Product IDs (create in Polar Dashboard → Products)
POLAR_PRODUCT_ID_STARTER_MONTHLY=""
POLAR_PRODUCT_ID_STARTER_ANNUAL=""
POLAR_PRODUCT_ID_PRO_MONTHLY=""
POLAR_PRODUCT_ID_PRO_ANNUAL=""
POLAR_PRODUCT_ID_ULTRA_PRO_MONTHLY=""
POLAR_PRODUCT_ID_ULTRA_PRO_ANNUAL=""

# Redis Configuration (for caching and sessions)
# NOTE: Changed from standard port 6379 to 8520 to follow project port convention (8500-8599)
REDIS_URL="redis://localhost:8520"
REDIS_PORT="8520"
REDIS_PASSWORD=""

# Email Configuration (for password reset, etc.)
EMAIL_SERVICE="smtp"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Security Features
ENABLE_RATE_LIMITING="true"
ENABLE_COMPRESSION="true"
ENABLE_CACHE="true"
ENABLE_PERFORMANCE_MONITORING="true"
ENABLE_SECURITY_HEADERS="true"
ENABLE_HTTPS_REDIRECT="true"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"
AUTH_RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"

# CORS Configuration
CORS_ORIGIN="http://localhost:8556,https://yourdomain.com"
CORS_CREDENTIALS="true"

# File Upload Security
MAX_FILE_SIZE="10485760"  # 10MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# Application Configuration
NODE_ENV="development"
PORT="8550"
CLIENT_URL="http://localhost:8556"
API_BASE_URL="http://localhost:8550"

# SSL/TLS Configuration (Production)
SSL_KEY_PATH="/path/to/ssl/private.key"
SSL_CERT_PATH="/path/to/ssl/certificate.crt"

# Monitoring and Logging
LOG_LEVEL="info"
LOG_FORMAT="json"
ENABLE_REQUEST_LOGGING="true"

# Axiom Centralized Logging (AI-powered observability)
# Get credentials: https://app.axiom.co → Settings → API Tokens
# Free tier: 500GB ingest/month, 30-day retention
AXIOM_TOKEN=""
AXIOM_DATASET="thumbnail-maker"
AXIOM_ORG_ID=""

# Session Security
SESSION_SECRET="your-session-secret-min-32-chars-890"
COOKIE_SECURE="false"  # Set to true in production with HTTPS
COOKIE_SAME_SITE="strict"
COOKIE_HTTP_ONLY="true"

# API Keys (if needed)
OPENAI_API_KEY="CHANGE_ME_TO_YOUR_OPENAI_API_KEY"

# =============================================================================
# CLOUDINARY CONFIGURATION (Image Storage & CDN)
# Get credentials from: https://cloudinary.com/console
# =============================================================================
# Option 1: Single URL (recommended)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Option 2: Individual credentials (alternative)
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# Cloudinary folder structure (optional customization)
# CLOUDINARY_FOLDER_THUMBNAILS="thumpiks/thumbnails"
# CLOUDINARY_FOLDER_PROCESSED="thumpiks/processed"
# CLOUDINARY_FOLDER_EPHEMERAL="thumpiks/ephemeral"

# Ephemeral upload TTL for visual search (seconds, default: 3600 = 1 hour)
# CLOUDINARY_EPHEMERAL_TTL="3600"

# =============================================================================
# STORACHA CONFIGURATION (Decentralized Storage - Future)
# Get credentials from: https://console.storacha.network
# Docs: https://docs.storacha.network/js-client/
# =============================================================================
# STORACHA_SPACE_DID="did:key:your_space_did"
# STORACHA_PROOF="your_base64_encoded_proof"
# Note: Storacha data is PUBLIC by design (content-addressed IPFS)
# Use for shareable thumbnails only, not sensitive data

# Additional AI Provider APIs
# =============================================================================
# COMETAPI CONFIGURATION
# Get API key from: https://api.cometapi.com (Dashboard → API Token → Add Token)
# =============================================================================
COMET_API_KEY="CHANGE_ME_TO_YOUR_COMET_API_KEY"
COMET_API_URL="https://api.cometapi.com"  # Base URL (no /v1 suffix)

# CometAPI Model Configuration
# FLUX models: flux-dev (default), flux-schnell (fast), flux-pro (best quality)
COMET_FLUX_MODEL="flux-dev"
COMET_REPLICATE_MODEL="black-forest-labs/flux-dev"  # Replicate-compatible endpoint
COMET_OPENAI_MODEL="dall-e-3"  # OpenAI-style endpoint fallback

# =============================================================================
# ZENMUX AI CONFIGURATION
# Get API key from: https://zenmux.ai (Dashboard)
# Docs: https://docs.zenmux.ai/guide/advanced/image-generation.html
# =============================================================================
ZENMUX_API_KEY="CHANGE_ME_TO_YOUR_ZENMUX_API_KEY"
ZENMUX_API_URL="https://zenmux.ai/api/v1"  # Chat completions endpoint
ZENMUX_VERTEX_URL="https://zenmux.ai/api/vertex-ai"  # Image generation endpoint (Vertex AI protocol)

# ZenMux Model Configuration
# Available: google/gemini-2.5-flash-image, google/gemini-3-pro-image-preview
# Free tiers: google/gemini-2.5-flash-image-free, google/gemini-3-pro-image-preview-free
ZENMUX_IMAGE_MODEL="google/gemini-2.5-flash-image"

# =============================================================================
# OPENROUTER CONFIGURATION
# Get API key from: https://openrouter.ai/keys
# Docs: https://openrouter.ai/docs/guides/overview/multimodal/image-generation
# =============================================================================
OPENROUTER_API_KEY="CHANGE_ME_TO_YOUR_OPENROUTER_API_KEY"
OPENROUTER_API_URL="https://openrouter.ai/api/v1"

# OpenRouter Model Configuration (per AI tool type)
# Each tool can use a different model optimized for its task
# See https://openrouter.ai/collections/image-models for available models
OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image"  # Default/fallback model
OPENROUTER_MODEL_GENERATE="google/gemini-2.5-flash-image"  # Text-to-image (fast, good for thumbnails)
OPENROUTER_MODEL_INPAINT="google/gemini-3-pro-image-preview"  # Inpainting (contextual edits)
OPENROUTER_MODEL_FACESWAP="bytedance-seed/seedream-4.5"  # Face swap (portrait optimization)
OPENROUTER_MODEL_UPSCALE="black-forest-labs/flux.2-max"  # Upscaling (detail preservation)
OPENROUTER_MODEL_VISION="google/gemini-2.5-flash-preview"  # Vision analysis (image understanding)

# =============================================================================
# VISION ANALYSIS - Image Search (priority: SearXNG -> SerpAPI -> Bing)
# SearXNG: Self-hosted, FREE, no rate limits (docker run -p 8080:8080 searxng/searxng)
# SerpAPI: https://serpapi.com (100 free/month, $50/month for 5,000)
# Bing: https://portal.azure.com (1,000 free/month, ~$3/1,000 calls)
# =============================================================================
# SearXNG (primary - free, self-hosted, no API key needed)
# Dev: docker run -d -p 8080:8080 --name searxng searxng/searxng
# Prod: Deploy to your own server or use a public instance
SEARXNG_URL=""

# SerpAPI (fallback 1 - simple signup)
SERPAPI_KEY=""

# Bing (fallback 2 - Azure portal)
BING_SEARCH_API_KEY=""
BING_SEARCH_ENDPOINT="https://api.bing.microsoft.com/v7.0/images/search"

# =============================================================================
# VISUAL SEARCH - Jina AI Embeddings (jina-clip-v2)
# Get API key from: https://jina.ai → Sign up → API Keys
# Free tier: 1M tokens/month | Paid: ~$0.02/1M tokens
# =============================================================================
JINA_API_KEY="CHANGE_ME_TO_YOUR_JINA_API_KEY"
JINA_API_URL="https://api.jina.ai/v1/embeddings"

# =============================================================================
# VISUAL SEARCH - Qdrant Vector Database
# DEVELOPMENT: Use local Qdrant (Docker or binary)
#   docker run -p 6333:6333 qdrant/qdrant
# PRODUCTION: Use Qdrant Cloud (https://cloud.qdrant.io)
# =============================================================================
# Development (local Qdrant - no API key needed)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Production (Qdrant Cloud - uncomment and fill these for Railway)
# QDRANT_URL="https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333"
# QDRANT_API_KEY="your-qdrant-cloud-api-key"

# =============================================================================
# REPLICATE CONFIGURATION (Computer Vision: SAM Segmentation, Remove BG, Upscale, Expand)
# Get API key from: https://replicate.com/account/api-tokens
# Docs: https://replicate.com/docs/reference/http
# =============================================================================
REPLICATE_API_KEY="CHANGE_ME_TO_YOUR_REPLICATE_API_KEY"

# Replicate Model Configuration (per AI tool type) - Updated Feb 2025
# Each tool uses a purpose-built model optimized for its task
REPLICATE_MODEL_SEGMENT="meta/sam-2"                      # SAM 2 auto-segmentation (grid-based, returns all detected masks)
REPLICATE_MODEL_SEGMENT_INTERACTIVE="meta/sam-2-video"    # SAM 2 interactive (click_coordinates for point-click selection)
REPLICATE_MODEL_REMOVE_BG="bria/remove-background"        # RMBG 2.0 - 256 transparency levels, commercially licensed
REPLICATE_MODEL_UPSCALE="astramlco/supir"                 # SUPIR - photo-realistic restoration, removes AI plastic look
REPLICATE_MODEL_EXPAND="bria/expand-image"                # Bria Expand - outpainting/canvas expansion, commercially licensed

# =============================================================================
# YOUTUBE DATA API v3 (Trending Thumbnails)
# Get API key from: https://console.cloud.google.com
# 1. Create project → Enable "YouTube Data API v3" → Create API key
# Free tier: 10,000 units/day (videos.list = 1 unit per call)
# =============================================================================
YOUTUBE_API_KEY=""

# Security Headers
CONTENT_SECURITY_POLICY="default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'"

# Test User Configuration (Development/Testing Only)
# Set to 'true' to enable automatic test user seeding in production (NOT RECOMMENDED)
SEED_TEST_USERS="false"
