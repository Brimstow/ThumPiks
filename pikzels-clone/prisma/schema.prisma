generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminNotification {
  id        String    @id
  title     String
  message   String
  type      String
  priority  String    @default("normal")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  metadata  Json?

  @@index([createdAt])
  @@index([isRead])
  @@index([priority])
  @@index([type])
}

model AdminRole {
  id          String    @id
  userId      String
  role        String
  permissions Json
  assignedBy  String?
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  User        User      @relation(fields: [userId], references: [id])

  @@unique([userId, role])
  @@index([isActive])
  @@index([role])
  @@index([userId])
}

model AuditLog {
  id                          String   @id
  userId                      String?
  adminId                     String?
  action                      String
  resource                    String
  resourceId                  String?
  details                     Json?
  ipAddress                   String?
  userAgent                   String?
  timestamp                   DateTime @default(now())
  severity                    String   @default("info")
  User_AuditLog_adminIdToUser User?    @relation("AuditLog_adminIdToUser", fields: [adminId], references: [id])
  User_AuditLog_userIdToUser  User?    @relation("AuditLog_userIdToUser", fields: [userId], references: [id])

  @@index([action])
  @@index([adminId])
  @@index([resource])
  @@index([severity])
  @@index([timestamp])
  @@index([userId])
}

model FeatureFlag {
  id          String   @id
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  config      Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isEnabled])
  @@index([name])
}

model Project {
  id                                               String      @id
  name                                             String
  description                                      String?
  userId                                           String
  teamId                                           String?
  createdAt                                        DateTime    @default(now())
  updatedAt                                        DateTime
  featuredThumbnailId                              String?     @unique
  parentProjectId                                  String?
  folderType                                       String      @default("project")
  depth                                            Int         @default(0)
  projectPath                                      String?
  category                                         String?
  isArchived                                       Boolean     @default(false)
  Thumbnail_Project_featuredThumbnailIdToThumbnail Thumbnail?  @relation("Project_featuredThumbnailIdToThumbnail", fields: [featuredThumbnailId], references: [id])
  Project                                          Project?    @relation("ProjectToProject", fields: [parentProjectId], references: [id])
  other_Project                                    Project[]   @relation("ProjectToProject")
  Team                                             Team?       @relation(fields: [teamId], references: [id])
  User                                             User        @relation(fields: [userId], references: [id])
  Thumbnail_Thumbnail_projectIdToProject           Thumbnail[] @relation("Thumbnail_projectIdToProject")

  @@index([depth])
  @@index([parentProjectId])
  @@index([teamId])
  @@index([userId])
  @@index([isArchived])
}

model SocialShare {
  id           String    @id
  thumbnailId  String
  userId       String
  platform     String
  shareUrl     String?
  shareId      String?
  status       String
  errorMessage String?
  sharedAt     DateTime  @default(now())
  engagement   Json?
  Thumbnail    Thumbnail @relation(fields: [thumbnailId], references: [id])
  User         User      @relation(fields: [userId], references: [id])
}

model Subscription {
  id                   String   @id
  planType             String
  creditsBalance       Int
  creditsUsed          Int      @default(0)
  periodStart          DateTime
  periodEnd            DateTime
  userId               String
  createdAt            DateTime @default(now())
  billingCycle         String   @default("monthly")
  cancelAtPeriodEnd    Boolean  @default(false)
  status               String   @default("active")
  stripePriceId        String?
  stripeSubscriptionId String?  @unique
  polarSubscriptionId  String?  @unique
  polarProductId       String?
  billingProvider      String   @default("stripe")
  User                 User     @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([stripeSubscriptionId])
  @@index([polarSubscriptionId])
  @@index([billingProvider])
  @@index([userId])
}

model CreditTransaction {
  id              String   @id @default(uuid())
  userId          String
  type            String
  amount          Int
  description     String
  stripePaymentId String?
  polarOrderId    String?
  metadata        Json?
  createdAt       DateTime @default(now())
  User            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SystemHealth {
  id        String   @id @default(uuid())
  service   String
  status    String
  response  Float?
  errorRate Float?
  details   Json?
  checkedAt DateTime @default(now())

  @@index([checkedAt])
  @@index([service])
  @@index([status])
}

model SystemMetrics {
  id             String   @id @default(uuid())
  metricType     String
  metricValue    Float
  metricDate     DateTime
  additionalData Json?
  createdAt      DateTime @default(now())

  @@unique([metricType, metricDate])
  @@index([metricDate])
  @@index([metricType])
}

model Team {
  id             String           @id
  name           String
  description    String?
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Project        Project[]
  User           User             @relation(fields: [ownerId], references: [id])
  TeamInvitation TeamInvitation[]
  TeamMember     TeamMember[]

  @@index([ownerId])
}

model TeamInvitation {
  id                                  String    @id
  teamId                              String
  inviterId                           String
  inviteeId                           String
  status                              String
  invitedAt                           DateTime  @default(now())
  respondedAt                         DateTime?
  User_TeamInvitation_inviteeIdToUser User      @relation("TeamInvitation_inviteeIdToUser", fields: [inviteeId], references: [id])
  User_TeamInvitation_inviterIdToUser User      @relation("TeamInvitation_inviterIdToUser", fields: [inviterId], references: [id])
  Team                                Team      @relation(fields: [teamId], references: [id])

  @@index([inviteeId])
  @@index([status])
  @@index([teamId])
}

model TeamMember {
  id       String   @id
  teamId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  Team     Team     @relation(fields: [teamId], references: [id])
  User     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Template {
  id          String    @id
  name        String
  description String?
  thumbnailId String
  creatorId   String
  parameters  Json
  tags        Json
  isPublic    Boolean   @default(false)
  downloads   Int       @default(0)
  likes       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [creatorId], references: [id])
  Thumbnail   Thumbnail @relation(fields: [thumbnailId], references: [id])

  @@index([creatorId])
  @@index([isPublic])
  @@index([thumbnailId])
}

model Thumbnail {
  id                                             String          @id
  title                                          String
  imageUrl                                       String
  originalImageUrl                               String?
  prompt                                         String          @default("")
  parameters                                     Json
  projectId                                      String
  userId                                         String
  createdAt                                      DateTime        @default(now())
  isFeatured                                     Boolean         @default(false)
  downloadCount                                  Int             @default(0)
  editCount                                      Int             @default(0)
  storagePublicId                                String?
  storageProvider                                String?         @default("cloudinary")
  deletedAt                                      DateTime?
  ABTestVariant                                  ABTestVariant[]
  Project_Project_featuredThumbnailIdToThumbnail Project?        @relation("Project_featuredThumbnailIdToThumbnail")
  SocialShare                                    SocialShare[]
  Template                                       Template[]
  Project_Thumbnail_projectIdToProject           Project         @relation("Thumbnail_projectIdToProject", fields: [projectId], references: [id])
  User                                           User            @relation(fields: [userId], references: [id])

  @@index([storagePublicId])
  @@index([deletedAt])
}

model User {
  id                                            String              @id @default(uuid())
  email                                         String              @unique
  username                                      String              @unique
  passwordHash                                  String
  name                                          String
  avatarUrl                                     String?
  isVerified                                    Boolean             @default(false)
  emailVerificationToken                        String?             @unique
  emailVerificationExpiry                       DateTime?
  displayPreference                             String              @default("name")
  settings                                      Json?
  createdAt                                     DateTime            @default(now())
  updatedAt                                     DateTime            @updatedAt
  lastLoginAt                                   DateTime?
  isActive                                      Boolean             @default(true)
  stripeCustomerId                              String?             @unique
  stripeSubscriptionId                          String?
  polarCustomerId                               String?             @unique
  youtubeAccessToken                            String?
  youtubeRefreshToken                           String?
  youtubeChannelId                              String?
  youtubeConnectedAt                            DateTime?
  emailUnsubscribedAt                           DateTime?
  emailVerified                                 Boolean             @default(false)
  marketingEmails                               Boolean             @default(true)
  productUpdates                                Boolean             @default(true)
  securityAlerts                                Boolean             @default(true)
  weeklyDigest                                  Boolean             @default(false)
  ABTest                                        ABTest[]
  ABTestImpression                              ABTestImpression[]
  AdminRole                                     AdminRole[]
  AuditLog_AuditLog_adminIdToUser               AuditLog[]          @relation("AuditLog_adminIdToUser")
  AuditLog_AuditLog_userIdToUser                AuditLog[]          @relation("AuditLog_userIdToUser")
  CreditTransaction                             CreditTransaction[]
  Project                                       Project[]
  SocialShare                                   SocialShare[]
  Subscription                                  Subscription[]
  Team                                          Team[]
  TeamInvitation_TeamInvitation_inviteeIdToUser TeamInvitation[]    @relation("TeamInvitation_inviteeIdToUser")
  TeamInvitation_TeamInvitation_inviterIdToUser TeamInvitation[]    @relation("TeamInvitation_inviterIdToUser")
  TeamMember                                    TeamMember[]
  Template                                      Template[]
  Thumbnail                                     Thumbnail[]
  CompositionLayout                             CompositionLayout[]
  UserAsset                                     UserAsset[]
  UserUrlHistory                                UserUrlHistory[]
  VisionAnalysis                                VisionAnalysis[]
  // Brand Kit relations
  BrandLogo                                     BrandLogo[]
  BrandColorPalette                             BrandColorPalette[]
  BrandFont                                     BrandFont[]
  BrandVoice                                    BrandVoice?
  BrandPhoto                                    BrandPhoto[]
  BrandGraphic                                  BrandGraphic[]
  BrandIcon                                     BrandIcon[]
  BrandStylePreset                              BrandStylePreset[]
  BrandCustomCategory                           BrandCustomCategory[]
  // Feedback & Contact relations
  Feedback                                      Feedback[]
  ContactSubmission                             ContactSubmission[]  @relation("contactSubmissions")
  // Global Chat relations
  ChatSession                                   ChatSession[]
  // Password Reset relations
  PasswordResetToken                            PasswordResetToken[]
  // Email relations
  EmailLog                                      EmailLog[]
  // Review relations
  Review                                        Review?
}

model VisionAnalysis {
  id              String   @id @default(uuid())
  userId          String
  imageUrl        String
  description     String
  suggestedPrompt String
  elements        Json
  sourceType      String
  createdAt       DateTime @default(now())
  User            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model ABTest {
  id          String             @id @default(uuid())
  name        String
  description String?
  userId      String
  status      String             @default("draft")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  User        User               @relation(fields: [userId], references: [id])
  impressions ABTestImpression[]
  variants    ABTestVariant[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ABTestVariant {
  id               String             @id @default(uuid())
  testId           String
  name             String
  thumbnailId      String
  impressions      Int                @default(0)
  clicks           Int                @default(0)
  ctr              Float              @default(0)
  isControl        Boolean            @default(false)
  ABTestImpression ABTestImpression[]
  ABTest           ABTest             @relation(fields: [testId], references: [id], onDelete: Cascade)
  Thumbnail        Thumbnail          @relation(fields: [thumbnailId], references: [id])

  @@index([testId])
  @@index([thumbnailId])
}

model ABTestImpression {
  id        String        @id @default(uuid())
  testId    String
  variantId String
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime      @default(now())
  ABTest    ABTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  User      User          @relation(fields: [userId], references: [id])
  Variant   ABTestVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([variantId])
  @@index([userId])
  @@index([createdAt])
}

model UserAsset {
  id              String   @id @default(uuid())
  userId          String
  type            String   @default("other")
  url             String
  publicId        String
  name            String?
  sizeBytes       Int      @default(0)
  mimeType        String?
  width           Int?
  height          Int?
  createdAt       DateTime @default(now())
  User            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model UserUrlHistory {
  id                 String   @id @default(uuid())
  userId             String
  url                String
  title              String?
  platform           String?
  thumbnailUrl       String?
  selectedFrameTime  Float?
  pinned             Boolean  @default(false)
  createdAt          DateTime @default(now())
  User               User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@unique([userId, url])
}

model CompositionLayout {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  category           String   @default("custom")
  tags               Json     @default("[]")
  canvasWidth        Int      @default(1920)
  canvasHeight       Int      @default(1080)
  wireframeSvg       String
  slots              Json
  textSlots          Json     @default("[]")
  fallbackBackground String?
  previewUrl         String?
  builtIn            Boolean  @default(false)
  isPublic           Boolean  @default(true)
  popularity         Int      @default(0)
  downloads          Int      @default(0)
  likes              Int      @default(0)
  creatorId          String?
  User               User?    @relation(fields: [creatorId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([builtIn])
  @@index([creatorId])
  @@index([popularity])
}

model UserSession {
  id           String    @id
  userId       String
  sessionId    String    @unique
  ipAddress    String?
  userAgent    String?
  loginAt      DateTime  @default(now())
  lastActivity DateTime  @default(now())
  logoutAt     DateTime?
  isActive     Boolean   @default(true)

  @@index([isActive])
  @@index([lastActivity])
  @@index([sessionId])
  @@index([userId])
}

// ============================================
// PASSWORD RESET MODELS
// ============================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  isUsed    Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([isUsed])
  @@index([createdAt])
}

// ============================================
// BRAND KIT MODELS
// ============================================

model BrandLogo {
  id        String   @id @default(uuid())
  userId    String
  name      String
  url       String
  publicId  String?
  variant   String   @default("full") // full, icon, light, dark
  isPrimary Boolean  @default(false)
  fileType  String   @default("png") // svg, png, jpg
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model BrandColorPalette {
  id        String             @id @default(uuid())
  userId    String
  name      String
  isPrimary Boolean            @default(false)
  createdAt DateTime           @default(now())
  User      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  colors    BrandColorSwatch[]

  @@index([userId])
  @@index([createdAt])
}

model BrandColorSwatch {
  id        String            @id @default(uuid())
  paletteId String
  hex       String
  name      String
  role      String            @default("custom") // primary, secondary, accent, neutral, custom
  Palette   BrandColorPalette @relation(fields: [paletteId], references: [id], onDelete: Cascade)

  @@index([paletteId])
}

model BrandFont {
  id          String   @id @default(uuid())
  userId      String
  name        String
  fontFamily  String
  weights     Json     @default("[]") // Array of {weight, label, style}
  role        String   @default("custom") // heading, subheading, body, custom
  previewText String   @default("Aa")
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model BrandVoice {
  id          String   @id @default(uuid())
  userId      String   @unique // One brand voice per user
  tone        String
  description String
  keywords    Json     @default("[]") // String array
  dos         Json     @default("[]") // String array
  donts       Json     @default("[]") // String array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrandPhoto {
  id           String   @id @default(uuid())
  userId       String
  name         String
  url          String
  publicId     String?
  thumbnailUrl String?
  tags         Json     @default("[]") // String array
  category     String   @default("custom") // headshot, background, product, lifestyle, custom
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model BrandGraphic {
  id           String   @id @default(uuid())
  userId       String
  name         String
  url          String
  publicId     String?
  thumbnailUrl String?
  type         String   @default("custom") // overlay, shape, pattern, sticker, badge, custom
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model BrandIcon {
  id        String   @id @default(uuid())
  userId    String
  name      String
  svg       String   @db.Text
  category  String   @default("custom") // action, social, media, ui, custom
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model BrandStylePreset {
  id             String   @id @default(uuid())
  userId         String
  name           String
  previewUrl     String?
  textPlacement  String   @default("center") // top-left, top-center, top-right, center, bottom-left, bottom-center, bottom-right
  overlayColor   String   @default("#000000")
  overlayOpacity Float    @default(0.5)
  fontPairing    Json     @default("{}") // {heading: string, body: string}
  colorScheme    Json     @default("[]") // String array of hex colors
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model BrandCustomCategory {
  id          String   @id @default(uuid())
  userId      String
  name        String
  icon        String   @default("Folder") // Lucide icon name
  color       String   @default("slate")
  bgColor     String   @default("bg-slate-500/10")
  borderColor String   @default("border-slate-500/20")
  textColor   String   @default("text-slate-400")
  hoverColor  String   @default("group-hover:text-slate-300")
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// FEEDBACK & TICKETING MODELS
// ============================================

model Feedback {
  id                 String    @id @default(uuid())
  userId             String
  type               String    // "BUG" | "FEATURE_REQUEST" | "GENERAL"
  subject            String
  message            String    @db.Text
  screenshotUrl      String?
  screenshotPublicId String?
  sentiment          String?   // "POSITIVE" | "NEGATIVE" | "NEUTRAL" | "MIXED"
  sentimentScore     Float?    // 0.0 - 1.0
  category           String?   // AI-detected: "ui", "performance", "billing", etc.
  tags               Json      @default("[]")
  aiSummary          String?
  priority           String    @default("MEDIUM")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  User               User      @relation(fields: [userId], references: [id])
  Ticket             Ticket?

  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([sentiment])
  @@index([createdAt])
  @@index([category])
}

model Ticket {
  id                String              @id @default(uuid())
  feedbackId        String?             @unique
  status            String              @default("OPEN") // "OPEN" | "IN_PROGRESS" | "WAITING" | "RESOLVED" | "CLOSED"
  assignee          String?
  resolution        String?             @db.Text
  internalNotes     String?             @db.Text
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Feedback          Feedback?           @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  Replies           TicketReply[]
  ContactSubmission ContactSubmission?
  ChatSession       ChatSession?

  @@index([status])
  @@index([assignee])
  @@index([createdAt])
}

model TicketReply {
  id         String   @id @default(uuid())
  ticketId   String
  authorType String   // "ADMIN" | "USER"
  authorId   String
  authorName String
  message    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  Ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model NotificationConfig {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., "feedback.submitted", "ticket.updated", "digest.daily"
  channels  Json     // ["admin_panel", "email"]
  emails    Json     // ["dev@example.com"]
  enabled   Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CONTACT SUBMISSION MODELS
// ============================================

model ContactSubmission {
  id                 String    @id @default(uuid())
  name               String
  email              String
  subject            String    // "general" | "support" | "billing" | "feature" | "bug"
  message            String    @db.Text
  screenshotUrl      String?
  screenshotPublicId String?
  status             String    @default("PENDING") // "PENDING" | "TRIAGED" | "AUTO_RESOLVED" | "TICKET_CREATED" | "DISMISSED"
  triageResult       Json?
  aiResponseSent     Boolean   @default(false)
  ticketId           String?   @unique
  userId             String?
  ipAddress          String?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  User               User?     @relation("contactSubmissions", fields: [userId], references: [id])
  Ticket             Ticket?   @relation(fields: [ticketId], references: [id])

  @@index([status])
  @@index([subject])
  @@index([createdAt])
  @@index([email])
}

// ============================================
// GLOBAL CHAT MODELS
// ============================================

model ChatSession {
  id                  String        @id @default(uuid())
  userId              String
  title               String?
  scope               String        @default("general") // "product" | "billing" | "feedback" | "general"
  status              String        @default("active")   // "active" | "archived" | "escalated"
  escalatedToTicketId String?       @unique
  metadata            Json?
  messageCount        Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  lastMessageAt       DateTime?
  User                User          @relation(fields: [userId], references: [id])
  Ticket              Ticket?       @relation(fields: [escalatedToTicketId], references: [id])
  messages            ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([lastMessageAt])
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  role          String      // "user" | "assistant" | "system"
  content       String      @db.Text
  imageUrl      String?
  imagePublicId String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  ChatSession   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model EmailLog {
  id                String    @id @default(uuid())
  userId            String?
  emailType         String    // "password_reset", "welcome", "verification"
  recipientEmail    String
  fromEmail         String
  subject           String
  status            String    // "pending", "sent", "delivered", "bounced", "failed"
  providerMessageId String?   // Resend's message ID
  errorMessage      String?
  errorCode         String?
  bounceReason      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  User              User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([recipientEmail])
  @@index([status])
  @@index([emailType])
  @@index([createdAt])
  @@index([providerMessageId])
}

// ============================================
// REVIEW / TESTIMONIAL MODELS
// ============================================

model Review {
  id          String    @id @default(uuid())
  userId      String
  rating      Int       // 1-5 stars
  title       String?   // Optional short headline
  body        String    @db.Text // Review text
  channelName String?   // e.g. "@TechExplained"
  channelUrl  String?   // YouTube channel URL
  subscribers String?   // e.g. "245K"
  niche       String?   // e.g. "Gaming", "Cooking", "Tech"
  improvement String?   // e.g. "+175% CTR", "5 hrs/week saved"
  status      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  isFeatured  Boolean   @default(false) // Featured on landing page
  adminNote   String?   // Internal note from admin
  reviewedAt  DateTime? // When admin reviewed
  reviewedBy  String?   // Admin user ID
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  User        User      @relation(fields: [userId], references: [id])

  @@unique([userId]) // One review per user
  @@index([status])
  @@index([isFeatured])
  @@index([rating])
  @@index([createdAt])
}
