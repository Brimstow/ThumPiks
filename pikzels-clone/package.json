{
  "name": "pikzels-clone",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:all": "node start-all-services.js",
    "start:databases": "node start-all-services.js --databases-only",
    "start:apps": "node start-all-services.js --apps-only",
    "start:check": "node start-all-services.js --check",
    "stop:all": "node graceful-shutdown.js --emergency",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:frontend": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build": "tsc --project tsconfig.build.json",
    "start": "sh start.sh",
    "start:server": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --bail --coverage --maxWorkers=50%",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report test-results/playwright-report",
    "test:thumbnails": "playwright test tests/e2e/thumbnail-operations.spec.ts --headed --project=chromium",
    "test:users:create": "npx ts-node create-test-users.ts",
    "test:users:seed": "npx prisma db seed",
    "test:users:verify": "npx ts-node verify-test-users.ts",
    "test:users:remove": "npx ts-node remove-test-users.ts",
    "pre-commit": "bash .husky/pre-commit",
    "pre-push": "bash .husky/pre-push",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio --port 8560",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "db:setup": "npm run prisma:migrate:deploy && npm run prisma:generate && npm run prisma:seed",
    "db:reset": "npx prisma migrate reset --force",
    "admin:create": "npx ts-node src/scripts/admin-setup.ts create",
    "admin:list": "npx ts-node src/scripts/admin-setup.ts list",
    "ports:validate": "node validate-ports.js",
    "ports:check": "pwsh -c \"netstat -an | Select-String ':8550'; netstat -an | Select-String ':8556'\"",
    "ports:cleanup": "node cleanup-ports.js --all",
    "ports:kill": "node cleanup-ports.js --kill",
    "ports:range": "node cleanup-ports.js --check",
    "zombie:kill": "node kill-zombies.js",
    "zombie:kill:all": "node kill-zombies.js --all",
    "zombie:kill:frontend": "node kill-zombies.js --port 8556",
    "zombie:kill:backend": "node kill-zombies.js --port 8550",
    "restart:check": "node auto-restart.js --check",
    "restart:force": "node auto-restart.js --restart",
    "restart:monitor": "node auto-restart.js --monitor",
    "dev:safe": "node smart-restart.js --check && npm run dev:all",
    "dev:restart": "node smart-restart.js --full",
    "dev:quick": "node smart-restart.js --quick",
    "dev:stop": "node graceful-shutdown.js --all",
    "dev:health": "node services-detector.js --check",
    "dev:conflicts": "node services-detector.js --conflicts",
    "monitor:start": "node service-monitor-agent.js --start --config service-monitor.config.js",
    "monitor:stop": "node service-monitor-agent.js --stop",
    "monitor:restart": "node service-monitor-agent.js --restart --config service-monitor.config.js",
    "monitor:cycle": "node service-monitor-agent.js --stop && node service-monitor-agent.js --start --config service-monitor.config.js",
    "monitor:start:debug": "node service-monitor-agent.js --start --config service-monitor.config.js --log-level debug",
    "monitor:start:production": "node service-monitor-agent.js --start --config service-monitor.config.js --log-level warn",
    "monitor:dashboard": "echo \"Dashboard available at http://localhost:8577\" && start http://localhost:8577",
    "monitor:status": "curl -s http://localhost:8577 | jq .",
    "monitor:frontend": "node frontend-health-test.js",
    "monitor:ports": "node services-detector.js --check && echo \"\n=== PORT COMPLIANCE CHECK ===\" && node frontend-health-test.js",
    "monitor:conflicts": "node services-detector.js --conflicts",
    "monitor:all": "npm run monitor:ports && echo \"\n=== STARTING COMPREHENSIVE MONITORING ===\" && npm run monitor:start:debug",
    "lint": "eslint src/**/*.{ts,tsx} --fix",
    "lint:client": "cd client && npx eslint \"src/**/*.ts\" \"src/**/*.tsx\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:client": "cd client && prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:all": "npm run format && npm run format:client",
    "lint:all": "npm run lint && npm run lint:client",
    "check": "npm run lint:all && npm run format:all",
    "db:optimize": "ts-node src/scripts/optimize-database.ts optimize",
    "db:check": "ts-node src/scripts/optimize-database.ts check",
    "perf:test": "ts-node src/scripts/performance-test.ts",
    "security:scan": "node scripts/security-scan.js",
    "security:audit": "npm audit --audit-level moderate",
    "security:secrets": "secretlint \"**/*\"",
    "security:secrets:staged": "secretlint $(git diff --cached --name-only --diff-filter=ACM)",
    "security:check": "npm run security:audit && npm run security:scan && npm run security:secrets",
    "coverage:analyze": "node scripts/improve-coverage.js",
    "commit": "cz",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/ioredis": "^4.28.10",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.3",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "isomorphic-dompurify": "^2.28.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "playwright": "^1.56.0",
    "qrcode": "^1.5.4",
    "redis": "^5.8.3",
    "sharp": "^0.34.3",
    "speakeasy": "^2.0.0",
    "stripe": "^20.3.0",
    "uuid": "^13.0.0",
    "validator": "^13.15.15",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.57.0",
    "@secretlint/secretlint-rule-pattern": "^11.2.5",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.18.0",
    "secretlint": "^11.2.5",
    "semver": "^7.7.2",
    "snyk": "^1.1299.1",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=-1",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
