{
  "name": "pikzels-clone",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:frontend": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "admin:create": "npx ts-node src/scripts/admin-setup.ts create",
    "admin:list": "npx ts-node src/scripts/admin-setup.ts list",
    "ports:validate": "node validate-ports.js",
    "ports:check": "netstat -an | findstr :8550 && netstat -an | findstr :8556",
    "ports:cleanup": "node cleanup-ports.js --all",
    "ports:kill": "node cleanup-ports.js --kill",
    "ports:range": "node cleanup-ports.js --check",
    "restart:check": "node auto-restart.js --check",
    "restart:force": "node auto-restart.js --restart",
    "restart:monitor": "node auto-restart.js --monitor",
    "restart:smart": "node smart-restart.js",
    "dev:coordinated": "pwsh -ExecutionPolicy Bypass -File reliable-coordinator.ps1 -Action start",
    "dev:watch": "pwsh -ExecutionPolicy Bypass -File reliable-coordinator.ps1 -Action watch",
    "dev:restart": "pwsh -ExecutionPolicy Bypass -File reliable-coordinator.ps1 -Action restart",
    "dev:stop": "pwsh -ExecutionPolicy Bypass -File reliable-coordinator.ps1 -Action stop",
    "lint": "eslint src/**/*.{ts,tsx} --fix",
    "lint:client": "cd client && eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:client": "cd client && prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:all": "npm run format && npm run format:client",
    "lint:all": "npm run lint && npm run lint:client",
    "check": "npm run lint:all && npm run format:all",
    "db:optimize": "ts-node src/scripts/optimize-database.ts optimize",
    "db:check": "ts-node src/scripts/optimize-database.ts check",
    "perf:test": "ts-node src/scripts/performance-test.ts",
    "security:scan": "node scripts/security-scan.js",
    "security:audit": "npm audit --audit-level moderate",
    "security:check": "npm run security:audit && npm run security:scan",
    "commit": "cz",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/ioredis": "^4.28.10",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.3",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "isomorphic-dompurify": "^2.28.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "playwright": "^1.56.0",
    "qrcode": "^1.5.4",
    "redis": "^5.8.3",
    "sharp": "^0.34.3",
    "speakeasy": "^2.0.0",
    "uuid": "^13.0.0",
    "validator": "^13.15.15",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.2.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "semver": "^7.7.2",
    "snyk": "^1.1299.1",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ],
    "client/src/**/*.{ts,tsx}": [
      "cd client && eslint --fix",
      "cd client && prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
