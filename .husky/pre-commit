#!/usr/bin/env sh

echo "🔐 PRE-COMMIT: Enterprise Quality Gate"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Block .env file commits
echo "🔒 [1/5] Checking for sensitive files..."
if git diff --cached --name-only | grep -qE "^\.env$|^\.env\.local$"; then
  echo "❌ ERROR: Attempting to commit .env file!"
  echo "Please remove it from staging: git reset HEAD .env"
  exit 1
fi

# Run secretlint on staged files
echo "🔐 [2/5] Scanning for secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
  npx secretlint $STAGED_FILES
  if [ $? -ne 0 ]; then
    echo "❌ Secret detection failed! Please remove sensitive data."
    exit 1
  fi
fi

# Run lint-staged (format & lint)
echo "🎨 [3/5] Running code formatting and linting..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Linting failed! Fix errors above."
  exit 1
fi

# Run FULL test suite - NO BYPASS
# Note: sharing.test.ts is excluded from pre-commit (heap OOM due to test isolation
# issue). It runs in CI where workers have more memory. Fix: properly tear down
# mock instances in that test file.
echo "🧪 [4/5] Running FULL test suite (strict mode)..."
cd pikzels-clone && npm test -- --bail --maxWorkers=50% --testPathIgnorePatterns="sharing\.test\.ts"
if [ $? -ne 0 ]; then
  echo "❌ Tests FAILED! Cannot commit broken code."
  echo "Fix tests or use 'git commit --no-verify' to bypass (NOT RECOMMENDED)."
  exit 1
fi

# TypeScript compilation check
echo "📘 [5/5] TypeScript compilation check..."
npx tsc --noEmit --skipLibCheck
if [ $? -ne 0 ]; then
  echo "⚠️  TypeScript warnings detected (non-blocking)."
  echo "Consider fixing before pushing."
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ All checks passed! Commit approved."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
